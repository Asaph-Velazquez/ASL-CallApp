PORT=3101
MONGODB_URI=mongodb://asl-callapp-mongo:27017/asl-call
CALL_JWT_SECRET=change-this-call-secret
INTERPRETER_JWT_SECRET=change-this-interpreter-secret
ASL_WEB_API_URL=http://localhost:3001
# URL publica opcional del gateway cuando el panel del interprete o clientes remotos
# consumen este servicio detras de un reverse proxy. Solo informativa/documental.
PUBLIC_GATEWAY_BASE_URL=
# Red de proxies confiables para respetar x-forwarded-for/x-forwarded-host/x-forwarded-proto.
# En desarrollo local detras de Docker Desktop/Nginx suele bastar con estos rangos privados.
TRUST_PROXY=loopback,linklocal,uniquelocal
CALL_INTERNAL_TOKEN=change-this-shared-token
REPORT_FORWARD_TIMEOUT_MS=8000
INTERPRETER_DEFAULT_USERNAME=interpreter
INTERPRETER_DEFAULT_PASSWORD=hotel2026
INTERPRETER_DEFAULT_FULL_NAME=Hotel Interpreter
# Origins permitidos para CORS del panel del interprete y herramientas locales.
# No mezclar aqui el upstream interno (localhost:3101); usar origins publicos o de desarrollo.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://localhost:8081
